// Insert this function inside match /databases/{database}/documents.
// Replace PLACEHOLDER_SYNC_UID with the same writer UID used by Radar rules.
function notRadarSyncAccount() {
  return request.auth == null || request.auth.uid != 'PLACEHOLDER_SYNC_UID';
}
