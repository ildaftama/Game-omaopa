// Merge INSIDE match /databases/{database}/documents. Keep all existing rules.
// Admin, Admin Utama and Master have access by default.
// Ordinary staff and old forecast-only grants do not grant access.
function forecastManager() {
  return request.auth != null
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('super',false) == true
      || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('master',false) == true);
}
function forecastStaff() {
  return request.auth != null
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && (forecastManager()
      || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('admin',false) == true
);
}
match /forecastAccess/{uid} {
  allow read: if forecastManager();
  allow write: if false;
}
function forecastReference(d, key) {
  return forecastManager() && d.schemaVersion == 2
    && d.updatedAt == request.time && d.updatedBy == request.auth.uid
    && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
    && ((key == 'reference_current' && d.kind == 'reference-manifest'
      && d.keys().hasOnly(['schemaVersion','kind','chunks','sha256','updatedAt','updatedBy'])
      && d.chunks is list && d.chunks.size() > 0 && d.chunks.size() <= 10)
    || (key.matches('^reference_[a-f0-9]{16}_[0-9]$') && d.kind == 'reference-chunk'
      && d.keys().hasOnly(['schemaVersion','kind','payload','sha256','updatedAt','updatedBy'])
      && d.payload is string && d.payload.size() <= 700000));
}
function forecastQuantity(q) { return q is int && q >= 0 && q <= 10000; }
function forecastQuantities(a) {
  return a is list && a.size() == 12
    && forecastQuantity(a[0]) && forecastQuantity(a[1])
    && forecastQuantity(a[2]) && forecastQuantity(a[3])
    && forecastQuantity(a[4]) && forecastQuantity(a[5])
    && forecastQuantity(a[6]) && forecastQuantity(a[7])
    && forecastQuantity(a[8]) && forecastQuantity(a[9])
    && forecastQuantity(a[10]) && forecastQuantity(a[11]);
}
function forecastActive(a) {
  return a is list && a.size() == 12
    && a[0] is bool && a[1] is bool && a[2] is bool && a[3] is bool
    && a[4] is bool && a[5] is bool && a[6] is bool && a[7] is bool
    && a[8] is bool && a[9] is bool && a[10] is bool && a[11] is bool;
}
function forecastPlan(p, d) {
  return p is map
    && p.keys().hasOnly(['date','outlet','active','regular','orders','note','prices','recommendations','method','cutoff'])
    && p.date == d.date && p.outlet == d.outlet
    && forecastActive(p.active) && forecastQuantities(p.regular) && forecastQuantities(p.orders)
    && p.note is string && p.note.size() <= 500
    && p.prices is list && p.prices.size() == 12
    && p.recommendations is list && p.recommendations.size() == 12
    && p.method in ['weekday-median-trend-v1','pcs-pooled-locked-v2'];
}
function forecastRecord(d, key) {
  return d.keys().hasOnly(['schemaVersion','date','outlet','revision','plan','baseline','firstSavedAt','savedAt','savedBy'])
    && d.schemaVersion == 1 && d.revision is int && d.revision >= 1
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.outlet in ['ambarawa','boyolali','gajah-raya','godean','jakal-uii','karanganyar','laweyan','makamhaji','merbabu','muntilann','ngaliyan','nusa-indah','nusukan','pemuda-magelang','rajawali','sampangan','sragen','sukoharjo','tajem','temanggung','udinus','uksw','ums','umy','undip','unimus','unnes','uns']
    && key == d.date + '_' + d.outlet
    && d.savedBy == request.auth.uid && d.savedAt == request.time
    && d.firstSavedAt is timestamp && forecastPlan(d.plan,d);
}
match /forecastPlans/{key} {
  allow read: if forecastStaff();
  allow create: if forecastReference(request.resource.data,key) || (forecastStaff() && forecastRecord(request.resource.data,key)
    && request.resource.data.revision == 1
    && request.resource.data.firstSavedAt == request.time
    && request.resource.data.baseline == request.resource.data.plan
    && getAfter(/databases/$(database)/documents/forecastPlans/$(key)/revisions/1).data == request.resource.data);
  allow update: if forecastReference(request.resource.data,key) || (forecastStaff() && forecastRecord(request.resource.data,key)
    && request.resource.data.date == resource.data.date
    && request.resource.data.outlet == resource.data.outlet
    && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.baseline == resource.data.baseline
    && request.resource.data.firstSavedAt == resource.data.firstSavedAt
    && getAfter(/databases/$(database)/documents/forecastPlans/$(key)/revisions/$(string(request.resource.data.revision))).data == request.resource.data);
  allow delete: if false;
  match /revisions/{revision} {
    allow read: if forecastStaff();
    // The matching parent is validated above in the same atomic write.
    // Avoid evaluating the entire 12-SKU payload twice for one revision.
    allow create: if forecastStaff()
      && request.resource.data.savedBy == request.auth.uid
      && request.resource.data.savedAt == request.time
      && revision == string(request.resource.data.revision)
      && getAfter(/databases/$(database)/documents/forecastPlans/$(key)).data == request.resource.data;
    allow update, delete: if false;
  }
}
