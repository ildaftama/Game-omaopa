// Merge INSIDE match /databases/{database}/documents. Keep all existing rules.
// Admin, Admin Utama and Master have access by default.
// Ordinary staff and old forecast-only grants do not grant access.
function forecastManager() {
  return request.auth != null
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('super',false) == true
      || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('master',false) == true);
}
function forecastStaff() {
  return request.auth != null
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && (forecastManager()
      || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('admin',false) == true
);
}
// Forecaster: can read/write forecastPlans (plan + fulfillment) only.
// Never grants the private reference bundle, the old access-grant collection or settings.
function forecastPlanner() {
  return request.auth != null
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && (forecastStaff()
      || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('forecaster',false) == true);
}
match /forecastAccess/{uid} {
  allow read: if forecastManager();
  allow write: if false;
}
// Master harus setara Admin Utama (super) untuk pengaturan Forecast sendiri. Rules penuh
// yang ada (lihat firestore.full.snapshot-2026-10-21.rules baris ~297) hanya mengizinkan
// isSuper() menulis match generik settings/{id} — padahal source-cloud.js di client sudah
// mengizinkan super ATAU master. Match spesifik di bawah ini lebih spesifik daripada
// settings/{id} sehingga menang hanya untuk path ini; pengaturan lain (banner, HR, dst)
// tetap Admin Utama/HRD saja seperti sebelumnya, tidak ikut melebar.
// Tempatkan match ini SEBELUM/terpisah dari match /settings/{id} yang sudah ada, dan jangan
// hapus match /settings/{id} itu sendiri. Pertahankan juga pembungkus notRadarSyncAccount()
// yang sudah dipakai pada seluruh rule lain di rules penuh.
// 2026-11-10 (owner): Pengaturan Forecast hanya boleh diubah akun MASTER -- Admin Utama pun
// hanya bisa membaca, supaya website tidak sembarangan diubah.
// PENTING: match generik /settings/{id} di rules penuh mengizinkan isSuper() menulis SEMUA
// dokumen settings -- dan Firestore memberi akses kalau SATU rule saja mengizinkan. Jadi rule
// generik itu juga diubah (dipublikasikan 2026-11-10) menjadi:
//   allow write: if notRadarSyncAccount() && (isSuper() && id != 'forecastSources');
function forecastMaster() {
  return request.auth != null
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('master',false) == true;
}
// 2026-11-10 (owner, revisi): yang dikunci Master hanya "Data pendukung" (itu cuma navigasi di
// client). Sumber data, ambang batas, tampilan & daftar produk boleh diubah semua akun Forecast.
match /settings/forecastSources {
  allow read: if notRadarSyncAccount() && (true);
  allow write: if notRadarSyncAccount() && (forecastPlanner());
}
function forecastReference(d, key) {
  return forecastManager() && d.schemaVersion == 2
    && d.updatedAt == request.time && d.updatedBy == request.auth.uid
    && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
    && ((key == 'reference_current' && d.kind == 'reference-manifest'
      && d.keys().hasOnly(['schemaVersion','kind','chunks','sha256','updatedAt','updatedBy'])
      && d.chunks is list && d.chunks.size() > 0 && d.chunks.size() <= 10)
    || (key.matches('^reference_[a-f0-9]{16}_[0-9]$') && d.kind == 'reference-chunk'
      && d.keys().hasOnly(['schemaVersion','kind','payload','sha256','updatedAt','updatedBy'])
      && d.payload is string && d.payload.size() <= 700000));
}
function forecastQuantity(q) { return q is int && q >= 0 && q <= 10000; }
function forecastQuantities(a) {
  return a is list && a.size() == 12
    && forecastQuantity(a[0]) && forecastQuantity(a[1])
    && forecastQuantity(a[2]) && forecastQuantity(a[3])
    && forecastQuantity(a[4]) && forecastQuantity(a[5])
    && forecastQuantity(a[6]) && forecastQuantity(a[7])
    && forecastQuantity(a[8]) && forecastQuantity(a[9])
    && forecastQuantity(a[10]) && forecastQuantity(a[11]);
}
function forecastActive(a) {
  return a is list && a.size() == 12
    && a[0] is bool && a[1] is bool && a[2] is bool && a[3] is bool
    && a[4] is bool && a[5] is bool && a[6] is bool && a[7] is bool
    && a[8] is bool && a[9] is bool && a[10] is bool && a[11] is bool;
}
// Optional manual items beyond the locked 12-SKU core (feature: forecaster adds a kue type
// the pipeline does not recommend yet). No recommendation/buffer applies to these.
function forecastCustomItem(it) {
  return it is map && it.keys().hasOnly(['name','regular','orders'])
    && it.name is string && it.name.size() >= 1 && it.name.size() <= 60
    && forecastQuantity(it.regular) && forecastQuantity(it.orders);
}
function forecastCustomItems(a) {
  return a is list && a.size() <= 20 && a.all(it, forecastCustomItem(it));
}
function forecastPlan(p, d) {
  return p is map
    && p.keys().hasOnly(['date','outlet','active','regular','orders','note','prices','recommendations','method','cutoff','customItems'])
    && p.date == d.date && p.outlet == d.outlet
    && forecastActive(p.active) && forecastQuantities(p.regular) && forecastQuantities(p.orders)
    && p.note is string && p.note.size() <= 500
    && p.prices is list && p.prices.size() == 12
    && p.recommendations is list && p.recommendations.size() == 12
    && p.method in ['weekday-median-trend-v1','pcs-pooled-locked-v2']
    && (!('customItems' in p) || forecastCustomItems(p.customItems));
}
function forecastRecord(d, key) {
  return d.keys().hasOnly(['schemaVersion','date','outlet','revision','plan','baseline','firstSavedAt','savedAt','savedBy'])
    && d.schemaVersion == 1 && d.revision is int && d.revision >= 1
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.outlet in ['ambarawa','boyolali','gajah-raya','godean','jakal-uii','karanganyar','laweyan','makamhaji','merbabu','muntilann','ngaliyan','nusa-indah','nusukan','pemuda-magelang','rajawali','sampangan','sragen','sukoharjo','tajem','temanggung','udinus','uksw','ums','umy','undip','unimus','unnes','uns']
    && key == d.date + '_' + d.outlet
    && d.savedBy == request.auth.uid && d.savedAt == request.time
    && d.firstSavedAt is timestamp && forecastPlan(d.plan,d);
}
match /forecastPlans/{key} {
  allow read: if forecastPlanner();
  allow create: if forecastReference(request.resource.data,key) || (forecastPlanner() && forecastRecord(request.resource.data,key)
    && request.resource.data.revision == 1
    && request.resource.data.firstSavedAt == request.time
    && request.resource.data.baseline == request.resource.data.plan
    && getAfter(/databases/$(database)/documents/forecastPlans/$(key)/revisions/1).data == request.resource.data);
  allow update: if forecastReference(request.resource.data,key) || (forecastPlanner() && forecastRecord(request.resource.data,key)
    && request.resource.data.date == resource.data.date
    && request.resource.data.outlet == resource.data.outlet
    && request.resource.data.revision == resource.data.revision + 1
    // Rencana yang sudah DIHAPUS (soft delete) lalu dibuat lagi: baseline & firstSavedAt mulai
    // baru dari rencana baru (dihitung akurasi hanya kalau disimpan sebelum hari H). Selain itu
    // baseline tetap terkunci seperti sebelumnya.
    && ((resource.data.get('deleted', null) == null
         && request.resource.data.baseline == resource.data.baseline
         && request.resource.data.firstSavedAt == resource.data.firstSavedAt)
      || (resource.data.get('deleted', null) != null
         && request.resource.data.baseline == request.resource.data.plan
         && request.resource.data.firstSavedAt == request.time))
    && getAfter(/databases/$(database)/documents/forecastPlans/$(key)/revisions/$(string(request.resource.data.revision))).data == request.resource.data)
    || forecastDeleteMark() || forecastRestoreMark();
  // Dokumen tidak pernah benar-benar dihapus: "hapus" = tanda deleted + entri log permanen.
  allow delete: if false;
  match /revisions/{revision} {
    allow read: if forecastPlanner();
    // The matching parent is validated above in the same atomic write.
    // Avoid evaluating the entire 12-SKU payload twice for one revision.
    allow create: if forecastPlanner()
      && request.resource.data.savedBy == request.auth.uid
      && request.resource.data.savedAt == request.time
      && revision == string(request.resource.data.revision)
      && getAfter(/databases/$(database)/documents/forecastPlans/$(key)).data == request.resource.data;
    allow update, delete: if false;
  }
  // Separate from revisions: what was actually shipped (production), recorded after the
  // fact and possibly by someone other than the forecaster. Never perturbs plan/baseline.
  match /fulfillment/{entry} {
    allow read: if forecastPlanner();
    allow create, update: if forecastPlanner() && entry == 'current'
      && request.resource.data.keys().hasOnly(['schemaVersion','shipped','recordedAt','recordedBy','note'])
      && request.resource.data.schemaVersion == 1
      && forecastQuantities(request.resource.data.shipped)
      && request.resource.data.recordedAt == request.time
      && request.resource.data.recordedBy == request.auth.uid
      && request.resource.data.note is string && request.resource.data.note.size() <= 500;
    allow delete: if false;
  }
}
// Hapus rencana (soft delete, owner 2026-11-10): hanya menambah field "deleted" (alasan wajib),
// isi rencana, baseline & revisi tidak berubah, dan WAJIB ada entri log di forecastPlanLog pada
// tulisan yang sama. Akurasi memakai rencana yang tidak dihapus; manajer melihat log-nya.
function forecastDeleteMark() {
  return forecastPlanner()
    && resource.data.get('deleted', null) == null
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
    && request.resource.data.deleted is map
    && request.resource.data.deleted.keys().hasOnly(['reason','by','byName','at','revision','logId'])
    && request.resource.data.deleted.reason is string
    && request.resource.data.deleted.reason.size() >= 5 && request.resource.data.deleted.reason.size() <= 500
    && request.resource.data.deleted.by == request.auth.uid
    && request.resource.data.deleted.byName is string && request.resource.data.deleted.byName.size() <= 100
    && request.resource.data.deleted.at == request.time
    && request.resource.data.deleted.revision == resource.data.revision
    && request.resource.data.deleted.logId is string
    && getAfter(/databases/$(database)/documents/forecastPlanLog/$(request.resource.data.deleted.logId)).data.at == request.time;
}
// Pulihkan rencana yang dihapus: hanya Admin Utama/Master, juga tercatat di log.
function forecastRestoreMark() {
  return forecastManager()
    && resource.data.get('deleted', null) != null
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
    && request.resource.data.get('deleted', null) == null;
}
match /forecastPlanLog/{id} {
  allow read: if forecastPlanner();
  allow create: if forecastPlanner()
    && request.resource.data.keys().hasOnly(['schemaVersion','action','key','date','outlet','revision','reason','by','byName','at','regular','orders'])
    && request.resource.data.schemaVersion == 1
    && request.resource.data.action in ['delete','restore']
    && request.resource.data.key == request.resource.data.date + '_' + request.resource.data.outlet
    && request.resource.data.revision is int
    && request.resource.data.reason is string
    && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 500
    && request.resource.data.by == request.auth.uid
    && request.resource.data.byName is string && request.resource.data.byName.size() <= 100
    && request.resource.data.at == request.time
    && forecastQuantities(request.resource.data.regular) && forecastQuantities(request.resource.data.orders)
    && ((request.resource.data.action == 'delete'
         && getAfter(/databases/$(database)/documents/forecastPlans/$(request.resource.data.key)).data.deleted.logId == id)
      || (request.resource.data.action == 'restore' && forecastManager()));
  allow update, delete: if false;
}
// Lean, non-financial bundle for forecaster-only accounts: outlet/product names, events,
// price references for the plan's own revenue estimate, research notes. No revenue trend,
// profit, waste or evaluation globals. Packed/verified the same way as forecastReference.
function forecastBrief(d, key) {
  return forecastManager() && d.schemaVersion == 2
    && d.updatedAt == request.time && d.updatedBy == request.auth.uid
    && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
    && ((key == 'forecaster_current' && d.kind == 'forecaster-manifest'
      && d.keys().hasOnly(['schemaVersion','kind','chunks','sha256','updatedAt','updatedBy'])
      && d.chunks is list && d.chunks.size() > 0 && d.chunks.size() <= 10)
    || (key.matches('^forecaster_[a-f0-9]{16}_[0-9]$') && d.kind == 'forecaster-chunk'
      && d.keys().hasOnly(['schemaVersion','kind','payload','sha256','updatedAt','updatedBy'])
      && d.payload is string && d.payload.size() <= 700000));
}
match /forecastBriefs/{key} {
  allow read: if forecastPlanner();
  allow create, update: if forecastBrief(request.resource.data, key);
  allow delete: if false;
}
// OPSIONAL -- hanya tambahkan kalau owner SETUJU akun sinkronisasi forecast (FIREBASE_SYNC_
// EMAIL, sudah forecastManager() lewat staff/{uid}.super atau .master) boleh MEMBACA collection
// "users" (database member: nama, telepon, tanggal lahir, umur, gender, homeOutlet, dll --
// data pribadi pelanggan). Tujuannya: skrip sinkronisasi membaca lalu mengagregasi jadi
// statistik per outlet TANPA data pribadi (cuma hitungan per kelompok umur/gender), sebelum
// disimpan ke bundle forecast. Read-only -- TIDAK ada "allow write" di sini sama sekali, dan
// hanya akun forecastManager() (sudah dipercaya penuh data finansial) yang dapat, bukan semua
// staff/forecaster. Kalau owner TIDAK mau akun sinkronisasi menyentuh data member sama sekali,
// JANGAN tambahkan blok ini -- fitur demografi customer per outlet tidak akan bisa dibangun.
// match /users/{uid} {
//   allow read: if forecastManager();
//   allow write: if false;
// }
