// Merge INSIDE match /databases/{database}/documents. Keep all existing rules.
// Admin, Admin Utama and Master have access by default.
// Ordinary staff and old forecast-only grants do not grant access.
function forecastManager() {
  return request.auth != null
    && ((forecastStaffAllowed() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      && (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('super',false) == true
        || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('master',false) == true))
      || forecastUserIn(['master','factory','spv']));
}
// Akun ID + password (owner 2026-11-24): peran di forecastUsers/{uid}, hanya berlaku saat status aktif.
function forecastUserIn(roles) {
  return request.auth != null
    && exists(/databases/$(database)/documents/forecastUsers/$(request.auth.uid))
    && get(/databases/$(database)/documents/forecastUsers/$(request.auth.uid)).data.get('status','') == 'active'
    && get(/databases/$(database)/documents/forecastUsers/$(request.auth.uid)).data.get('role','') in roles;
}
// Forecaster: can read/write forecastPlans (plan + fulfillment) only.
// Never grants the private reference bundle, the old access-grant collection or settings.
// Owner 2026-11-24: akses nomor HP (staff/{uid}) ditutup, kecuali Master pemilik dan akun
// sinkronisasi GitHub Actions yang menulis bundle referensi.
function forecastStaffAllowed() {
  return request.auth.uid in ['zeSmuwnL7NfllJPKcw1eYhCwpdl1','Lj11LJ0gB7XKzmm041nC29Xqfq43'];
}
function staffPlanner() {
  return request.auth != null && forecastStaffAllowed() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && forecastPlannerRole(get(/databases/$(database)/documents/staff/$(request.auth.uid)).data);
}
function forecastPlanner() {
  return staffPlanner() || forecastUserIn(['master','factory','spv','forecaster']);
}
// Data Analis hanya membaca.
function forecastViewer() {
  return forecastPlanner() || forecastUserIn(['analyst','esbadmin','guest']);
}
// Chat, status online, daftar nama, dan Kantor (tamu kini juga melihat data lewat forecastViewer).
function forecastCommunity() {
  return forecastViewer() || forecastUserIn(['guest']);
}
function forecastPlannerRole(s) {
  return s.get('super',false) == true || s.get('master',false) == true || s.get('admin',false) == true || s.get('forecaster',false) == true;
}
function forecastUserValid(d) {
  return d.keys().hasOnly(['id','name','status','role','char','createdAt','approvedBy'])
    && d.id is string && d.id.matches('^[a-z0-9][a-z0-9._-]{2,29}$')
    && d.name is string && d.name.size() > 0 && d.name.size() <= 40
    && d.status in ['pending','active','disabled']
    && d.role in ['','master','factory','spv','forecaster','analyst','esbadmin','guest']
    && (!('char' in d) || d.char in ['','f1','f2','ga1','ga2','ga3','gmk','ghr','gbd','gout','gfba']);
}
// Daftar sendiri: hanya akun @forecast.omaopa.fun miliknya, status menunggu, tanpa peran.
// Peran, status dan penghapusan hanya oleh Master.
match /forecastUsers/{uid} {
  allow read: if request.auth != null && (request.auth.uid == uid || forecastCommunity() || forecastMasterUser());
  allow create: if (request.auth != null && request.auth.uid == uid
      && request.auth.token.email == request.resource.data.id + '@forecast.omaopa.fun'
      && request.resource.data.keys().hasOnly(['id','name','status','role','createdAt'])
      && request.resource.data.status == 'pending' && request.resource.data.role == ''
      && request.resource.data.createdAt == request.time
      && forecastUserValid(request.resource.data))
    || (forecastMasterUser() && forecastUserValid(request.resource.data));
  allow update: if forecastMasterUser() && forecastUserValid(request.resource.data)
    && request.resource.data.id == resource.data.id;
  allow delete: if forecastMasterUser();
}
match /forecastAccess/{uid} {
  allow read: if forecastManager();
  allow write: if false;
}
// Master harus setara Admin Utama (super) untuk pengaturan Forecast sendiri. Rules penuh
// yang ada (lihat firestore.full.snapshot-2026-10-21.rules baris ~297) hanya mengizinkan
// isSuper() menulis match generik settings/{id} — padahal source-cloud.js di client sudah
// mengizinkan super ATAU master. Match spesifik di bawah ini lebih spesifik daripada
// settings/{id} sehingga menang hanya untuk path ini; pengaturan lain (banner, HR, dst)
// tetap Admin Utama/HRD saja seperti sebelumnya, tidak ikut melebar.
// Tempatkan match ini SEBELUM/terpisah dari match /settings/{id} yang sudah ada, dan jangan
// hapus match /settings/{id} itu sendiri. Pertahankan juga pembungkus notRadarSyncAccount()
// yang sudah dipakai pada seluruh rule lain di rules penuh.
// 2026-11-10 (owner): Pengaturan Forecast hanya boleh diubah akun MASTER -- Admin Utama pun
// hanya bisa membaca, supaya website tidak sembarangan diubah.
// PENTING: match generik /settings/{id} di rules penuh mengizinkan isSuper() menulis SEMUA
// dokumen settings -- dan Firestore memberi akses kalau SATU rule saja mengizinkan. Jadi rule
// generik itu juga diubah (dipublikasikan 2026-11-10) menjadi:
//   allow write: if notRadarSyncAccount() && (isSuper() && id != 'forecastSources');
// forecastMaster() dihapus 2026-11-10: tidak terpakai lagi (Firestore menolak fungsi tak terpakai).
// 2026-11-10 (owner, revisi): yang dikunci Master hanya "Data pendukung" (itu cuma navigasi di
// client). Sumber data, ambang batas, tampilan & daftar produk boleh diubah semua akun Forecast.
match /settings/forecastSources {
  allow read: if notRadarSyncAccount() && (true);
  allow write: if notRadarSyncAccount() && (staffPlanner() || forecastUserIn(['master','factory','spv']))
    && request.resource.data.get('logId','') is string && request.resource.data.get('logId','').size() > 0
    && getAfter(/databases/$(database)/documents/forecastChangeLog/$(request.resource.data.logId)).data.at == request.time;
}
function forecastReference(d, key) {
  return d.schemaVersion == 2 && forecastManager()
    && d.updatedAt == request.time && d.updatedBy == request.auth.uid
    && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
    && ((key == 'reference_current' && d.kind == 'reference-manifest'
      && d.keys().hasOnly(['schemaVersion','kind','chunks','sha256','updatedAt','updatedBy'])
      && d.chunks is list && d.chunks.size() > 0 && d.chunks.size() <= 10)
    || (key.matches('^reference_[a-f0-9]{16}_[0-9]$') && d.kind == 'reference-chunk'
      && d.keys().hasOnly(['schemaVersion','kind','payload','sha256','updatedAt','updatedBy'])
      && d.payload is string && d.payload.size() <= 700000));
}
function forecastQuantities(a) {
  // Ramping (2026-11-10): Firestore membatasi 1000 ekspresi per permintaan; cek per angka
  // (bilangan bulat 0..10000) dilakukan aplikasi saat simpan & baca (validPlan/validShipped).
  // Versi lama (cek tiap angka + forecastActive per elemen) + aturan kunci hari H melewati
  // batas itu -> SEMUA simpan rencana ditolak permission-denied (terukur di Rules Playground).
  return a is list && a.size() == 12;
}
function forecastActive(a) {
  return a is list && a.size() == 12;
}
// Optional manual items beyond the locked 12-SKU core (feature: forecaster adds a kue type
// the pipeline does not recommend yet). No recommendation/buffer applies to these.
function forecastCustomItems(a) {
  // Rules tidak punya list.all(); isi item divalidasi di aplikasi.
  return a is list && a.size() <= 20;
}
function forecastPlan(p, d) {
  return p is map
    && p.keys().hasOnly(['date','outlet','active','regular','orders','note','prices','recommendations','method','cutoff','customItems'])
    && p.date == d.date && p.outlet == d.outlet
    && forecastActive(p.active) && forecastQuantities(p.regular) && forecastQuantities(p.orders)
    && p.note is string && p.note.size() <= 500
    && p.prices is list && p.prices.size() == 12
    && p.recommendations is list && p.recommendations.size() == 12
    && p.method in ['weekday-median-trend-v1','pcs-pooled-locked-v2']
    && (!('customItems' in p) || forecastCustomItems(p.customItems));
}
function forecastRecord(d, key) {
  return d.keys().hasOnly(['schemaVersion','date','outlet','revision','plan','baseline','firstSavedAt','savedAt','savedBy'])
    && d.schemaVersion == 1 && d.revision is int && d.revision >= 1
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.outlet in ['ambarawa','boyolali','gajah-raya','godean','jakal-uii','karanganyar','laweyan','makamhaji','merbabu','muntilann','ngaliyan','nusa-indah','nusukan','pemuda-magelang','rajawali','sampangan','sragen','sukoharjo','tajem','temanggung','udinus','uksw','ums','umy','undip','unimus','unnes','uns','pabrik']
    && key == d.date + '_' + d.outlet
    && d.savedBy == request.auth.uid && d.savedAt == request.time
    && d.firstSavedAt is timestamp && forecastPlan(d.plan,d);
}
// Kunci setelah hari H (owner 2026-11-10): mulai 00.00 WIB tanggal rencana, rencana hanya bisa
// dibuat/diubah/dihapus akun Master. Realisasi kirim (fulfillment) tetap terbuka.
function forecastOpenDate(date) {
  return request.time < timestamp.date(int(date.split('-')[0]), int(date.split('-')[1]), int(date.split('-')[2])) - duration.value(7, 'h');
}
// Boleh mengubah rencana setelah hari H (owner 2026-11-24): Master, Factory Manager, SPV Logistik,
// dan setiap simpanan terlambat wajib punya entri forecastChangeLog pada tulisan yang sama.
function forecastLateEditor() {
  return request.auth != null
    && ((forecastStaffAllowed() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('master',false) == true)
      || forecastUserIn(['master','factory','spv']));
}
function forecastLateLogged(key, revision) {
  return getAfter(/databases/$(database)/documents/forecastChangeLog/$(key + '_r' + string(revision))).data.at == request.time;
}
function forecastMasterUser() {
  return request.auth != null
    && ((forecastStaffAllowed() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('master',false) == true)
      || forecastUserIn(['master']));
}
match /forecastPlans/{key} {
  allow read: if forecastViewer();
  allow create: if forecastReference(request.resource.data,key) || (forecastPlanner() && forecastRecord(request.resource.data,key)
    && (forecastOpenDate(request.resource.data.date) || (forecastLateEditor() && forecastLateLogged(key, request.resource.data.revision)))
    && request.resource.data.revision == 1
    && request.resource.data.firstSavedAt == request.time
    && request.resource.data.baseline == request.resource.data.plan
    && getAfter(/databases/$(database)/documents/forecastPlans/$(key)/revisions/1).data == request.resource.data);
  allow update: if forecastReference(request.resource.data,key) || (forecastPlanner() && forecastRecord(request.resource.data,key)
    && (forecastOpenDate(request.resource.data.date) || (forecastLateEditor() && forecastLateLogged(key, request.resource.data.revision)))
    && request.resource.data.date == resource.data.date
    && request.resource.data.outlet == resource.data.outlet
    && request.resource.data.revision == resource.data.revision + 1
    // Rencana yang sudah DIHAPUS (soft delete) lalu dibuat lagi: baseline & firstSavedAt mulai
    // baru dari rencana baru (dihitung akurasi hanya kalau disimpan sebelum hari H). Selain itu
    // baseline tetap terkunci seperti sebelumnya.
    && ((resource.data.get('deleted', null) == null
         && request.resource.data.baseline == resource.data.baseline
         && request.resource.data.firstSavedAt == resource.data.firstSavedAt)
      || (resource.data.get('deleted', null) != null
         && request.resource.data.baseline == request.resource.data.plan
         && request.resource.data.firstSavedAt == request.time))
    && getAfter(/databases/$(database)/documents/forecastPlans/$(key)/revisions/$(string(request.resource.data.revision))).data == request.resource.data)
    || forecastDeleteMark() || forecastRestoreMark();
  // Dokumen tidak pernah benar-benar dihapus: "hapus" = tanda deleted + entri log permanen.
  allow delete: if false;
  match /revisions/{revision} {
    allow read: if forecastViewer();
    // The matching parent is validated above in the same atomic write.
    // Avoid evaluating the entire 12-SKU payload twice for one revision.
    allow create: if forecastPlanner()
      && request.resource.data.savedBy == request.auth.uid
      && request.resource.data.savedAt == request.time
      && revision == string(request.resource.data.revision)
      && getAfter(/databases/$(database)/documents/forecastPlans/$(key)).data == request.resource.data;
    allow update, delete: if false;
  }
  // Separate from revisions: what was actually shipped (production), recorded after the
  // fact and possibly by someone other than the forecaster. Never perturbs plan/baseline.
  match /fulfillment/{entry} {
    allow read: if forecastViewer();
    allow create, update: if forecastPlanner() && entry == 'current'
      && request.resource.data.keys().hasOnly(['schemaVersion','shipped','recordedAt','recordedBy','note'])
      && request.resource.data.schemaVersion == 1
      && forecastQuantities(request.resource.data.shipped)
      && request.resource.data.recordedAt == request.time
      && request.resource.data.recordedBy == request.auth.uid
      && request.resource.data.note is string && request.resource.data.note.size() <= 500;
    allow delete: if false;
  }
}
// Hapus rencana (soft delete, owner 2026-11-10): hanya menambah field "deleted" (alasan wajib),
// isi rencana, baseline & revisi tidak berubah, dan WAJIB ada entri log di forecastPlanLog pada
// tulisan yang sama. Akurasi memakai rencana yang tidak dihapus; manajer melihat log-nya.
function forecastDeleteMark() {
  return forecastPlanner()
    && (forecastOpenDate(resource.data.date) || forecastLateEditor())
    && resource.data.get('deleted', null) == null
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
    && request.resource.data.deleted is map
    && request.resource.data.deleted.keys().hasOnly(['reason','by','byName','at','revision','logId'])
    && request.resource.data.deleted.reason is string
    && request.resource.data.deleted.reason.size() >= 5 && request.resource.data.deleted.reason.size() <= 500
    && request.resource.data.deleted.by == request.auth.uid
    && request.resource.data.deleted.byName is string && request.resource.data.deleted.byName.size() <= 100
    && request.resource.data.deleted.at == request.time
    && request.resource.data.deleted.revision == resource.data.revision
    && request.resource.data.deleted.logId is string
    && getAfter(/databases/$(database)/documents/forecastPlanLog/$(request.resource.data.deleted.logId)).data.at == request.time;
}
// Pulihkan rencana yang dihapus: hanya Admin Utama/Master, juga tercatat di log.
function forecastRestoreMark() {
  return forecastManager()
    && resource.data.get('deleted', null) != null
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
    && request.resource.data.get('deleted', null) == null;
}
match /forecastPlanLog/{id} {
  allow read: if forecastViewer();
  allow create: if forecastPlanner()
    && request.resource.data.keys().hasOnly(['schemaVersion','action','key','date','outlet','revision','reason','by','byName','at','regular','orders'])
    && request.resource.data.schemaVersion == 1
    && request.resource.data.action in ['delete','restore']
    && request.resource.data.key == request.resource.data.date + '_' + request.resource.data.outlet
    && request.resource.data.revision is int
    && request.resource.data.reason is string
    && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 500
    && request.resource.data.by == request.auth.uid
    && request.resource.data.byName is string && request.resource.data.byName.size() <= 100
    && request.resource.data.at == request.time
    && forecastQuantities(request.resource.data.regular) && forecastQuantities(request.resource.data.orders)
    && ((request.resource.data.action == 'delete'
         && getAfter(/databases/$(database)/documents/forecastPlans/$(request.resource.data.key)).data.deleted.logId == id)
      || (request.resource.data.action == 'restore' && forecastManager()));
  allow update, delete: if false;
}
// Lean, non-financial bundle for forecaster-only accounts: outlet/product names, events,
// price references for the plan's own revenue estimate, research notes. No revenue trend,
// profit, waste or evaluation globals. Packed/verified the same way as forecastReference.
function forecastBrief(d, key) {
  return d.schemaVersion == 2 && forecastManager()
    && d.updatedAt == request.time && d.updatedBy == request.auth.uid
    && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
    && ((key == 'forecaster_current' && d.kind == 'forecaster-manifest'
      && d.keys().hasOnly(['schemaVersion','kind','chunks','sha256','updatedAt','updatedBy'])
      && d.chunks is list && d.chunks.size() > 0 && d.chunks.size() <= 10)
    || (key.matches('^forecaster_[a-f0-9]{16}_[0-9]$') && d.kind == 'forecaster-chunk'
      && d.keys().hasOnly(['schemaVersion','kind','payload','sha256','updatedAt','updatedBy'])
      && d.payload is string && d.payload.size() <= 700000));
}
match /forecastBriefs/{key} {
  allow read: if forecastViewer();
  allow create, update: if forecastBrief(request.resource.data, key);
  allow delete: if false;
}
// Kendali karakter Kantor (owner 2026-11-24): tiap akun hanya karakternya sendiri, Master semua.
function forecastOfficeOwner(id) {
  return forecastMasterUser()
    || (id in ['f1','f2'] && (staffPlanner()
      || (forecastUserIn(['forecaster']) && get(/databases/$(database)/documents/forecastUsers/$(request.auth.uid)).data.get('char','') == id)))
    || (id == 'pred' && forecastUserIn(['analyst']))
    || (id == 'mgr' && forecastUserIn(['factory']))
    || (id == 'spv' && forecastUserIn(['spv']))
    || (id == 'esb' && forecastUserIn(['esbadmin']))
    || (id == 'guest' && forecastUserIn(['guest']))
    || (id in ['ga1','ga2','ga3','gmk','ghr','gbd','gout','gfba'] && forecastUserIn(['guest']) && get(/databases/$(database)/documents/forecastUsers/$(request.auth.uid)).data.get('char','') == id);
}
// Kantor Mini: arahan terakhir untuk karakter, supaya gerakannya sama di semua layar.
match /officeState/{id} {
  allow read: if forecastCommunity();
  allow create, update: if id in ['f1','f2','pred','mgr','spv','esb','pawang','watch','guest','ga1','ga2','ga3','gmk','ghr','gbd','gout','gfba'] && forecastOfficeOwner(id)
    && request.resource.data.keys().hasOnly(['act','x','y','at','by','cid'])
    && request.resource.data.act in ['go','kopi','snack','makan','sofa','nap','toilet','kerja']
    && request.resource.data.x is int && request.resource.data.x >= -5 && request.resource.data.x <= 25
    && request.resource.data.y is int && request.resource.data.y >= 0 && request.resource.data.y <= 16
    && request.resource.data.at == request.time && request.resource.data.by == request.auth.uid
    && request.resource.data.cid is string && request.resource.data.cid.size() <= 12;
  allow delete: if false;
}
// Chat tim (owner 2026-11-24): dibaca & ditulis semua akun Forecast. Pengirim bisa menarik pesan
// dalam 30 detik (aturan memberi kelonggaran 35 detik), Master bisa menghapus pesan apa pun.
match /forecastChat/{id} {
  allow read: if forecastCommunity();
  allow create: if forecastCommunity()
    && request.resource.data.keys().hasOnly(['uid','name','text','at','expireAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.name is string && request.resource.data.name.size() <= 60
    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
    && request.resource.data.at == request.time
    && request.resource.data.expireAt is timestamp;
  // Owner 2026-11-25: pengirim boleh mengedit teks pesannya sendiri dalam 10 menit (5 detik toleransi),
  // dan menarik (hapus) pesannya sendiri dalam 2 menit.
  allow update: if request.auth != null && resource.data.uid == request.auth.uid
    && request.time < resource.data.at + duration.value(605, 's')
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
    && request.resource.data.editedAt == request.time;
  allow delete: if forecastMasterUser()
    || (request.auth != null && resource.data.uid == request.auth.uid && request.time < resource.data.at + duration.value(125, 's'));
}
// Pengumuman System & notifikasi (owner 2026-11-26): dibaca semua akun Forecast, hanya Master
// yang membuat dan menghapus. Isi tidak bisa diubah; kirim ulang bila perlu koreksi.
match /forecastNotice/{id} {
  allow read: if forecastCommunity();
  allow create: if forecastMasterUser()
    && request.resource.data.keys().hasOnly(['title','text','link','chat','notif','at','by','expireAt'])
    && request.resource.data.title is string && request.resource.data.title.size() <= 80
    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
    && request.resource.data.link is string && request.resource.data.link.size() <= 30
    && request.resource.data.chat is bool && request.resource.data.notif is bool
    && request.resource.data.at == request.time && request.resource.data.by == request.auth.uid
    && request.resource.data.expireAt is timestamp;
  allow update: if false;
  allow delete: if forecastMasterUser();
}
// Catatan transfer antar-outlet (owner 2026-11-26): dibaca semua akun Forecast, dicatat oleh
// forecaster/manager/master. Pencatat boleh mengubah/menghapus catatannya sendiri; Master semuanya.
function forecastTransferValid(d) {
  return d.keys().hasOnly(['date','time','from','to','items','note','by','name','at','editedAt'])
    && d.date is string && d.date.size() == 10 && d.time is string && d.time.size() == 5
    && d.from is string && d.from.size() <= 40 && d.to is string && d.to.size() <= 40 && d.from != d.to
    && d.items is map && d.items.size() > 0 && d.items.size() <= 21
    && d.note is string && d.note.size() <= 200 && d.name is string && d.name.size() <= 60;
}
match /forecastTransfer/{id} {
  allow read: if forecastCommunity();
  allow create: if forecastPlanner() && forecastTransferValid(request.resource.data)
    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
  allow update: if forecastTransferValid(request.resource.data)
    && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
    && request.resource.data.editedAt == request.time
    && ((resource.data.by == request.auth.uid && forecastPlanner()) || forecastMasterUser());
  allow delete: if (resource.data.by == request.auth.uid && forecastPlanner()) || forecastMasterUser();
}
// Status online: tiap akun hanya menulis dokumennya sendiri.
match /forecastPresence/{uid} {
  allow read: if forecastCommunity();
  allow create, update: if request.auth != null && request.auth.uid == uid && forecastCommunity()
    && request.resource.data.keys().hasOnly(['name','role','char','at','online','chatRead','noticeRead','chatReads','noticeReads'])
    && request.resource.data.get('chatReads', []) is list && request.resource.data.get('chatReads', []).size() <= 40
    && request.resource.data.get('noticeReads', []) is list && request.resource.data.get('noticeReads', []).size() <= 40
    && request.resource.data.get('chatRead', request.time) is timestamp
    && request.resource.data.get('noticeRead', request.time) is timestamp
    && request.resource.data.name is string && request.resource.data.name.size() <= 60
    && request.resource.data.role is string && request.resource.data.role.size() <= 20
    && request.resource.data.char is string && request.resource.data.char.size() <= 4
    && request.resource.data.online is bool
    && request.resource.data.at == request.time;
  allow delete: if false;
}
// Log perubahan rencana setelah hari H & pengaturan. Dibaca Master & Factory Manager, 90 hari.
match /forecastChangeLog/{id} {
  allow read: if forecastMasterUser() || forecastUserIn(['factory']);
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['type','key','date','outlet','revision','summary','changes','by','byName','role','at','expireAt'])
    && request.resource.data.by == request.auth.uid
    && request.resource.data.at == request.time
    && request.resource.data.expireAt is timestamp
    && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
    && request.resource.data.changes is list && request.resource.data.changes.size() <= 60
    && request.resource.data.byName is string && request.resource.data.byName.size() <= 60
    && request.resource.data.role is string && request.resource.data.role.size() <= 20
    && ((request.resource.data.type == 'plan' && forecastPlanner() && id == request.resource.data.key + '_r' + string(request.resource.data.revision))
      || (request.resource.data.type == 'settings' && (staffPlanner() || forecastUserIn(['master','factory','spv']))));
  allow update: if false;
  allow delete: if forecastMasterUser();
}
// OPSIONAL -- hanya tambahkan kalau owner SETUJU akun sinkronisasi forecast (FIREBASE_SYNC_
// EMAIL, sudah forecastManager() lewat staff/{uid}.super atau .master) boleh MEMBACA collection
// "users" (database member: nama, telepon, tanggal lahir, umur, gender, homeOutlet, dll --
// data pribadi pelanggan). Tujuannya: skrip sinkronisasi membaca lalu mengagregasi jadi
// statistik per outlet TANPA data pribadi (cuma hitungan per kelompok umur/gender), sebelum
// disimpan ke bundle forecast. Read-only -- TIDAK ada "allow write" di sini sama sekali, dan
// hanya akun forecastManager() (sudah dipercaya penuh data finansial) yang dapat, bukan semua
// staff/forecaster. Kalau owner TIDAK mau akun sinkronisasi menyentuh data member sama sekali,
// JANGAN tambahkan blok ini -- fitur demografi customer per outlet tidak akan bisa dibangun.
